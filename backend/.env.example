# ---------------------------------------------------------------------------
# Sentinel AI backend configuration
# Copy this file to .env and fill in your own keys.
# ---------------------------------------------------------------------------

FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
HOST=0.0.0.0
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=surveillance

# ---------------------------------------------------------------------------
# NVR / IP camera (RTSP)
# Password and username are URL-encoded automatically.
# ---------------------------------------------------------------------------
CAMERA_HOST=
CAMERA_PORT=554
CAMERA_USER=admin
CAMERA_PASSWORD=
CAMERA_CHANNELS=16
ALLOWED_CAMERAS=2,4,5,7,8,9,11
CAMERA_SUBTYPE=0
# Optional full override, e.g. rtsp://user:pass@host:554/stream
CAMERA_STREAM_URL=
CAMERA_RTSP_TEMPLATE=rtsp://{user}:{password}@{host}:{port}/cam/realmonitor?channel={channel}&subtype={subtype}
CAMERA_FPS=12
FRAME_WIDTH=1280
JPEG_QUALITY=80
CAMERA_OPEN_TIMEOUT_MS=8000
CAMERA_READ_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Analysis behaviour
# ---------------------------------------------------------------------------
ANALYSIS_INTERVAL_SECONDS=3
ANALYSIS_WIDTH=640
FRAME_BUFFER_SECONDS=5
GREETING_WINDOW_SECONDS=8
INTERACTION_COOLDOWN_SECONDS=20
ALERT_COOLDOWN_SECONDS=120
SHOP_OPEN_TIME=06:00
SHOP_CLOSE_TIME=21:00
APP_TIMEZONE=Asia/Karachi
WAREHOUSE_AFTER_HOURS_START=21:00
WAREHOUSE_AFTER_HOURS_END=11:00
SHOP_ID=shop_001
SHOP_NAME=Main Shop
WAREHOUSE_ID=warehouse_001
WAREHOUSE_NAME=Main Warehouse
WAREHOUSE_ENTRY_LOCATION=main_gate
GREETING_PHRASES=hello,hi,hey,good morning,good afternoon,good evening,welcome,assalam o alaikum,assalamualaikum,salam,how can i help

# Unattended customer detection (shop)
UNATTENDED_DETECTION_ENABLED=false
UNATTENDED_ALERT_SECONDS=10
STAFF_PRESENCE_SECONDS=20
# Normalized staff bounding box: x1,y1,x2,y2 (0-1). Blank = greeting/persistence heuristic.
SHOPKEEPER_ZONE=

# Background escalation loop and scheduled report delivery
BACKGROUND_JOBS_ENABLED=true

# ---------------------------------------------------------------------------
# AWS Rekognition
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
REKOGNITION_ENABLED=true
REKOGNITION_MIN_CONFIDENCE=70

# ---------------------------------------------------------------------------
# OpenRouter (greeting reasoning / smart logic)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Alerts (email via Python smtplib)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=alerts@example.com
OWNER_EMAIL=
OWNER_NAME=Store Owner
SECONDARY_EMAIL=

# Escalation for unacknowledged critical alerts (seconds after creation)
ESCALATION_ENABLED=true
ESCALATION_EMAIL_AFTER=300
ESCALATION_SECONDARY_AFTER=900

# Firebase Cloud Messaging push (optional)
PUSH_ENABLED=true
FIREBASE_PROJECT_ID=
FIREBASE_DEVICE_TOKEN=

# Scheduled PDF reports
DAILY_REPORT_ENABLED=true
DAILY_REPORT_TIME=21:00
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_DAY=monday
VIP_LIST=

# ---------------------------------------------------------------------------
# Cloudinary (cloud image storage for snapshots)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sentinel-ai/snapshots

# Where snapshots are written (served from /static/snapshots)
UPLOAD_DIR=static/snapshots
